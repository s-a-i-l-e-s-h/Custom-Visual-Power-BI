                {
                    "actual": {
                        "max": 1
                    },
                    "target": {
                        "max": 1
                    },
                    "growth": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "actual"
                            }
                        },
                        {
                            "bind": {
                                "to": "target"
                            }
                        },
                        {
                            "bind": {
                                "to": "growth"
                            }
                        }
                    ]
                }
            }
        }
    ],
    "privileges": []
}
